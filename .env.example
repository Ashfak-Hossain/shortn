# shortn configuration — every variable the service reads from the environment.
# Copy to .env for local use. Values shown are the built-in defaults; the service
# boots with none of these set, using the defaults below.
#
# Config is read once at startup (internal/config). There are no config files; the
# environment is the single source of configuration (12-factor).

# --- Core ---
PORT=8080                 # public API and redirects
OPS_PORT=9090             # internal-only health, readiness, and metrics (never via the ingress)
LOG_LEVEL=info            # debug | info | warn | error
ENV=dev                   # dev | staging | prod

# --- Datastores ---
DATABASE_URL=postgres://dev:dev@localhost:5432/shortn?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- ID generation ---
# Each instance needs a unique worker id (0-1023). Leave WORKER_ID unset to lease a
# free id from Redis at startup (the Kubernetes path, where every pod runs the same
# image). Set it explicitly to assign by hand (the Compose path). A pod that cannot
# obtain a unique id refuses to start.
# WORKER_ID=0
INSTANCE_ID=              # identifies the instance in logs and the X-Served-By header; defaults to the hostname

# The sqids alphabet that obfuscates Snowflake ids into short codes. It must never
# change once codes have been issued, or existing codes decode to different ids.
SQIDS_ALPHABET=0aA1bB2cC3dD4eE5fF6gG7hH8iI9jJkKlLmMnNoOpPqQrRsStTuUvVwWxXyYzZ

# --- Messaging (Redpanda / Kafka API) ---
KAFKA_BROKERS=localhost:19092   # comma-separated; use redpanda:9092 from inside the Compose network
KAFKA_TOPIC=shortn.clicks
KAFKA_GROUP=shortn-analytics    # consumer group (read by the analytics binary)

# --- Resilience ---
RATE_LIMIT_RPS=10         # sustained requests/sec per client (token-bucket refill)
RATE_LIMIT_BURST=20       # token-bucket capacity (maximum burst)

# --- Admin ---
# Shared secret that gates listing all links and deleting a link, sent as the
# X-Admin-Key header. Unset means those endpoints are locked (fail-closed). Never
# commit a real value.
ADMIN_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318   # where traces are pushed (Tempo); use tempo:4318 inside Compose
# Opt in to the stable HTTP server metric. With http/dup the SDK also emits
# http.server.request.duration; note it writes milliseconds into the seconds
# histogram, so latency panels use http_server_duration_milliseconds.
# OTEL_SEMCONV_STABILITY_OPT_IN=http/dup
